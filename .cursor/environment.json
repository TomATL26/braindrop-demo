{
  "name": "Braindrop",
  "install": "cd worker && npx --yes wrangler@4.129.0 --version && { [ -f .dev.vars ] || printf 'DASH_TOKEN=dev-dash-token\\nTELEGRAM_SECRET=dev-telegram-secret\\nEMAIL_TOKEN=dev-email-token\\n' > .dev.vars; }",
  "terminals": [
    {
      "name": "dashboard",
      "command": "python3 -m http.server 8000 --bind 0.0.0.0"
    },
    {
      "name": "worker",
      "command": "cd worker && npx wrangler@4.129.0 dev --port 8787 --ip 0.0.0.0"
    }
  ],
  "ports": [
    { "name": "dashboard", "port": 8000 },
    { "name": "worker", "port": 8787 }
  ]
}
